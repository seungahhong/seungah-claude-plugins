# claude
.settings.local.json

# claude 런타임 메모리 (per-user 산출물 — 경로·세션ID·raw trace 포함, 버전관리 제외)
.claude/experience-store/
.claude/_workspace/
.claude/_workspace_prev/
.claude/plugin-store/

# OS 시스템 파일 (플러그인 디렉터리 검증에서 Blocking)
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/

# python bytecode (플러그인 스크립트 실행 시 생성)
__pycache__/
*.pyc

# skill-creator 트리거 eval이 만드는 임시 커맨드 파일 (실행 중에만 존재)
.claude/commands/*-skill-*.md
